{
  "expo": {
    "name": "pantry&me",
    "slug": "pantryandme",
    "owner": "caynh23s-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pantryandme",
    "userInterfaceStyle": "automatic",
    "extra": {
      "eas": {
        "projectId": "9097f93e-7790-43ef-81a3-64be84c41c53"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.caynh23.pantryandme",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2D6A4F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.caynh23.pantryandme",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FAFAF7"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "pantry&me uses your camera to scan food items into your ingredients list.",
          "photosPermission": "pantry&me reads photos you choose to scan food items into your ingredients list.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "pantry&me uses your camera to scan barcodes on packaged food.",
          "recordAudioAndroid": false
        }
      ],
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#2D6A4F",
          "defaultChannel": "expiration-reminders"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "autolinkingModuleResolution": false
    }
  }
}
