# URL of the pantry&me API.
# Web / iOS Simulator (API on same machine): http://localhost:3000
# Physical phone (same Wi-Fi): http://<your-mac-LAN-IP>:3000  (run: ipconfig getifaddr en0)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Supabase — anonymous auth + cloud sync. See docs/supabase-auth.md
# Without these, ingredients stay on this device.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google sign-in is configured in Google Cloud Console + the Supabase
# dashboard (Authentication → Providers → Google). No extra env var is
# required in the app; the Web client ID lives in Supabase.
